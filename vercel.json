{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/r/:code",
      "destination": "https://fittly-production.up.railway.app/r/:code",
      "statusCode": 307
    }
  ],
  "rewrites": [
    {
      "source": "/g/:path*",
      "destination": "https://fittly-production.up.railway.app/g/:path*"
    }
  ],
  "headers": [
    {
      "source": "/partners/(.*).pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
