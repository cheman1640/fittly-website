{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/r/:code",
      "destination": "https://fittly-production.up.railway.app/r/:code",
      "statusCode": 307
    }
  ],
  "rewrites": [
    {
      "source": "/g/:path*",
      "destination": "https://fittly-production.up.railway.app/g/:path*"
    }
  ]
}
